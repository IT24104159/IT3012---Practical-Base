class SimpleReflexAgent:

    
    def sense_and_act(self, percept) -> str:
        
        if percept['food_here']:
            return 'Stay' 
        
        if not percept['wall_up']:
            return 'Up'
        elif not percept['wall_right']:
            return 'Right'
        elif not percept['wall_down']:
            return 'Down'
        elif not percept['wall_left']:
            return 'Left'
        else:
            return 'Stay' 